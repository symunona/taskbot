# Shape of config/build-node.env (gitignored, machine-local).
# Do not write by hand: `just setup-build-node <ssh-dest> [workspace]` produces it.
BUILD_NODE_DEST=fanni-air
BUILD_NODE_WS=/home/USER/build/taltosbot
BUILD_NODE_GRADLE_HOME=/home/USER/build/gradle-taltosbot
BUILD_NODE_ANDROID_HOME=/home/USER/Android/Sdk
BUILD_NODE_JDK=/home/USER/.jdks/jdk-17.0.x+y
